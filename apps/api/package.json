{
  "name": "@lingo/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/tests/*.test.ts",
    "lint": "eslint .",
    "seed": "tsx seed.ts",
    "admin:create": "node dist/cli.js admin:create",
