    "admin:reset-mfa": "node dist/cli.js admin:reset-mfa"
  },
  "dependencies": {
    "@lingo/validation": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "@prisma/client": "6.19.3",
    "fastify": "^5.5.0",
    "argon2": "^0.44.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.35.0",
    "prisma": "6.19.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
