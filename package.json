{
  "name": "lingo-store",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "test:db": "pnpm --filter @lingo/api test:db",
    "db:generate": "pnpm --filter @lingo/api exec prisma generate --schema ../../prisma/schema.prisma",
    "db:push": "prisma db push",
    "db:seed": "tsx apps/api/seed.ts",
    "db:migrate:deploy": "bash ./scripts/db-migrate-deploy.sh",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml,css}\"",
    "security:check": "pnpm typecheck && pnpm test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@prisma/client": "6.19.3",
    "prettier": "^3.9.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma"
    ],
    "overrides": {
      "deepmerge-ts": "^8.0.0",
      "postcss": "^8.5.18"
    }
  }
}
