generator client {
 provider = "prisma-client-js" 
}

datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
 directUrl = env("MIGRATOR_DATABASE_URL")
}

enum StaffStatus {
  PENDING_SETUP
  ACTIVE
  DISABLED
}

enum Surface {
  ADMIN
  POS
}

enum SaleStatus {
  COMPLETED
  REFUNDED
  PARTIAL_REFUND
  NEEDS_REVIEW
}

enum WebOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY
  COMPLETED
  CANCELLED
}

enum WebOrderPaymentStatus {
  UNPAID
  PAID
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum CashStatus {
  OPEN
  CLOSED
}

enum SessionKind {
  CUSTOMER
  ADMIN
  POS
}

enum SessionState {
  PENDING_MFA
  ACTIVE
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}


model StaffUser {
 id String @id @default(uuid())
 username String @unique
 email String? @unique
 passwordHash String?
 name String
 status StaffStatus @default(PENDING_SETUP)
 isActive Boolean @default(true)
 mfaEnabled Boolean @default(false)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 sessions Session[]
 sales Sale[] @relation("SaleCashier")
 purchases Purchase[] @relation("PurchaseCreatedBy")
 expenses Expense[]
 cashSessions CashSession[]
 audits AuditLog[]
 mfaCredentials MfaCredential[]
 recoveryCodes RecoveryCode[]
 passwordResetTokens StaffPasswordResetToken[]
 invitations StaffInvitation[] @relation("InvitationInvitee")
 approvalsGranted Approval[] @relation("ApprovalGrantor")
 approvalsUsed Approval[] @relation("ApprovalUser")
 webOrderCashReceipts WebOrderCashReceipt[]
 roleAssignments StaffRoleAssignment[] 
 deviceSessions DeviceSession[]
}

model CustomerAccount {
 id String @id @default(uuid())
 email String @unique
 passwordHash String
 name String
 phone String?
 emailVerifiedAt DateTime? @db.Timestamptz(3)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 sessions Session[]
 passwordResetTokens PasswordResetToken[]
 verificationTokens EmailVerificationToken[]
 businessCustomerId String? @unique
 businessCustomer Customer? @relation(fields:[businessCustomerId],references:[id],onDelete:SetNull) 
 webOrders WebOrder[]
}

model Role {
 id String @id @default(uuid())
 name String @unique
 permissions RolePermission[]
 staff StaffRoleAssignment[] 
}

model Permission {
 id String @id @default(uuid())
 key String @unique
 description String?
 roles RolePermission[] 
}

model RolePermission {
 roleId String
 permissionId String
 role Role @relation(fields:[roleId],references:[id],onDelete:Cascade)
 permission Permission @relation(fields:[permissionId],references:[id],onDelete:Cascade)
 @@id([roleId,permissionId]) 
}

model StaffRoleAssignment {
 staffUserId String
 roleId String
 staffUser StaffUser @relation(fields:[staffUserId],references:[id],onDelete:Cascade)
 role Role @relation(fields:[roleId],references:[id],onDelete:Cascade)
 @@id([staffUserId,roleId]) 
}

model MfaCredential {
 id String @id @default(uuid())
 staffUserId String
 secretEncrypted String
 lastAcceptedStep BigInt @default(-1)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 staffUser StaffUser @relation(fields:[staffUserId],references:[id],onDelete:Cascade)
 @@index([staffUserId]) 
}

model RecoveryCode {
 id String @id @default(uuid())
 staffUserId String
 codeHash String
 usedAt DateTime? @db.Timestamptz(3)
 staffUser StaffUser @relation(fields:[staffUserId],references:[id],onDelete:Cascade)
 @@index([staffUserId,usedAt]) 
}

model StaffPasswordResetToken {
 id String @id @default(uuid())
 staffUserId String
 tokenHash String @unique
 expiresAt DateTime @db.Timestamptz(3)
 usedAt DateTime? @db.Timestamptz(3)
 staffUser StaffUser @relation(fields:[staffUserId],references:[id],onDelete:Cascade)
 @@index([staffUserId,usedAt]) 
}

model PasswordResetToken {
 id String @id @default(uuid())
 accountId String
 tokenHash String @unique
 expiresAt DateTime @db.Timestamptz(3)
 usedAt DateTime? @db.Timestamptz(3)
 account CustomerAccount @relation(fields:[accountId],references:[id],onDelete:Cascade) 
}

model EmailVerificationToken {
 id String @id @default(uuid())
 accountId String
 tokenHash String @unique
 expiresAt DateTime @db.Timestamptz(3)
 usedAt DateTime? @db.Timestamptz(3)
 account CustomerAccount @relation(fields:[accountId],references:[id],onDelete:Cascade) 
}

model StaffInvitation {
 id String @id @default(uuid())
 email String
 tokenHash String @unique
 roleName String?
 inviteeId String?
 expiresAt DateTime @db.Timestamptz(3)
 usedAt DateTime? @db.Timestamptz(3)
 revokedAt DateTime? @db.Timestamptz(3)
 mfaSecretEncrypted String?
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 invitee StaffUser? @relation("InvitationInvitee",fields:[inviteeId],references:[id],onDelete:SetNull)
 @@index([email,usedAt,revokedAt]) 
}

model Session {
 id String @id @default(uuid())
 tokenHash String @unique
 kind SessionKind
 state SessionState @default(ACTIVE)
 staffUserId String?
 customerAccountId String?
 terminalId String?
 expiresAt DateTime @db.Timestamptz(3)
 idleExpiresAt DateTime @db.Timestamptz(3)
 lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
 mfaVerifiedAt DateTime? @db.Timestamptz(3)
 stepUpUntil DateTime? @db.Timestamptz(3)
 ip String?
 userAgent String?
 revokedAt DateTime? @db.Timestamptz(3)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 staffUser StaffUser? @relation(fields:[staffUserId],references:[id],onDelete:Cascade)
 customerAccount CustomerAccount? @relation(fields:[customerAccountId],references:[id],onDelete:Cascade)
 terminal Terminal? @relation(fields:[terminalId],references:[id],onDelete:Cascade)
 @@index([kind,expiresAt])
 @@index([staffUserId])
 @@index([terminalId])
 @@index([state,expiresAt]) 
}

model Terminal {
 id String @id @default(uuid())
 name String @unique
 credentialHash String @unique
 isActive Boolean @default(true)
 previousCredentialHash String?
 previousCredentialExpiresAt DateTime? @db.Timestamptz(3)
 lastSeenAt DateTime? @db.Timestamptz(3)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 sessions Session[]
 enrollments TerminalEnrollment[]
 approvals Approval[]
 sales Sale[]
 cashSessions CashSession[] 
 deviceSessions DeviceSession[]
}

/// Opaque POS access and refresh tokens. Only SHA-256 hashes are persisted.
/// A refresh token belongs to a family so reuse can revoke every descendant.
model DeviceSession {
 id String @id @default(uuid())
 terminalId String
 staffUserId String
 familyId String
 accessTokenHash String @unique
 refreshTokenHash String @unique
 accessExpiresAt DateTime @db.Timestamptz(3)
 refreshExpiresAt DateTime @db.Timestamptz(3)
 rotatedAt DateTime? @db.Timestamptz(3)
 revokedAt DateTime? @db.Timestamptz(3)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 terminal Terminal @relation(fields:[terminalId],references:[id],onDelete:Cascade)
 staffUser StaffUser @relation(fields:[staffUserId],references:[id],onDelete:Cascade)
 @@index([terminalId,revokedAt])
 @@index([staffUserId,revokedAt])
 @@index([familyId])
}

model TerminalEnrollment {
 id String @id @default(uuid())
 codeHash String @unique
 expiresAt DateTime @db.Timestamptz(3)
 usedAt DateTime? @db.Timestamptz(3)
 terminalId String?
 terminal Terminal? @relation(fields:[terminalId],references:[id],onDelete:SetNull)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model Category {
 id String @id @default(uuid())
 name String @unique
 description String?
 products Product[]
 createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model Product {
 id String @id @default(uuid())
 sku String @unique
 barcode String? @unique
 name String
 description String?
 imageUrl String?
 costMinor BigInt
 priceMinor BigInt
 stock Decimal @default(0) @db.Decimal(14,3)
 minStock Decimal @default(0) @db.Decimal(14,3)
 version Int @default(1)
 archivedAt DateTime? @db.Timestamptz(3)
 categoryId String?
 category Category? @relation(fields:[categoryId],references:[id],onDelete:SetNull)
 saleItems SaleItem[]
 purchaseItems PurchaseItem[]
 movements InventoryMovement[]
 webOrderItems WebOrderItem[]
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@index([name])
 @@index([categoryId]) 
}

model WebOrder {
 id String @id @default(uuid())
 invoiceNo String @unique
 customerAccountId String
 status WebOrderStatus @default(PENDING)
 paymentStatus WebOrderPaymentStatus @default(UNPAID)
 paymentMethod PaymentMethod @default(CASH)
 subtotalMinor BigInt
 totalMinor BigInt
 recipientName String
 recipientPhone String
 shippingAddress String
 version Int @default(1)
 customerAccount CustomerAccount @relation(fields:[customerAccountId],references:[id],onDelete:Restrict)
 items WebOrderItem[]
 cashReceipts WebOrderCashReceipt[]
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@index([customerAccountId,createdAt])
 @@index([status,createdAt])
}

model WebOrderItem {
 id String @id @default(uuid())
 orderId String
 productId String
 productName String
 quantity Decimal @db.Decimal(14,3)
 unitPriceMinor BigInt
 unitCostMinor BigInt
 totalMinor BigInt
 order WebOrder @relation(fields:[orderId],references:[id],onDelete:Restrict)
 product Product @relation(fields:[productId],references:[id],onDelete:Restrict)
 @@index([orderId])
 @@index([productId])
}

model WebOrderCashReceipt {
 id String @id @default(uuid())
 orderId String
 amountMinor BigInt
 receivedByStaffId String
 idempotencyKey String
 order WebOrder @relation(fields:[orderId],references:[id],onDelete:Restrict)
 receivedBy StaffUser @relation(fields:[receivedByStaffId],references:[id],onDelete:Restrict)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@unique([orderId])
 @@index([receivedByStaffId,createdAt])
}

model Customer {
 id String @id @default(uuid())
 name String
 phone String? @unique
 email String?
 address String?
 account CustomerAccount?
 balanceMinor BigInt @default(0)
 sales Sale[]
 payments CustomerPayment[]
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Supplier {
 id String @id @default(uuid())
 name String
 phone String? @unique
 email String?
 address String?
 balanceMinor BigInt @default(0)
 purchases Purchase[]
 payments SupplierPayment[]
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Sale {
 id String @id @default(uuid())
 invoiceNo String @unique
 status SaleStatus @default(COMPLETED)
 subtotalMinor BigInt
 discountMinor BigInt @default(0)
 totalMinor BigInt
 paidMinor BigInt @default(0)
 customerId String?
 cashierId String
 terminalId String?
 customer Customer? @relation(fields:[customerId],references:[id],onDelete:SetNull)
 cashier StaffUser @relation("SaleCashier",fields:[cashierId],references:[id])
 terminal Terminal? @relation(fields:[terminalId],references:[id],onDelete:SetNull)
 items SaleItem[]
 payments Payment[]
 refunds Refund[]
 occurredAtClient DateTime? @db.Timestamptz(3)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([createdAt])
 @@index([cashierId,createdAt]) 
}

model SaleItem {
 id String @id @default(uuid())
 saleId String
 productId String
 quantity Decimal @db.Decimal(14,3)
 unitPriceMinor BigInt
 unitCostMinor BigInt
 totalMinor BigInt
 sale Sale @relation(fields:[saleId],references:[id],onDelete:Restrict)
 product Product @relation(fields:[productId],references:[id],onDelete:Restrict) 
}

model Refund {
 id String @id @default(uuid())
 saleId String
 amountMinor BigInt
 reason String
 approvedById String? @unique
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 sale Sale @relation(fields:[saleId],references:[id],onDelete:Restrict)
 approval Approval? @relation(fields:[approvedById],references:[id],onDelete:SetNull) 
}

model Payment {
 id String @id @default(uuid())
 saleId String
 amountMinor BigInt
 method PaymentMethod
 reference String?
 sale Sale @relation(fields:[saleId],references:[id],onDelete:Restrict)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model Purchase {
 id String @id @default(uuid())
 invoiceNo String @unique
 subtotalMinor BigInt
 totalMinor BigInt
 paidMinor BigInt @default(0)
 supplierId String?
 createdById String
 supplier Supplier? @relation(fields:[supplierId],references:[id],onDelete:SetNull)
 createdBy StaffUser @relation("PurchaseCreatedBy",fields:[createdById],references:[id])
 items PurchaseItem[]
 createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model PurchaseItem {
 id String @id @default(uuid())
 purchaseId String
 productId String
 quantity Decimal @db.Decimal(14,3)
 unitCostMinor BigInt
 totalMinor BigInt
 purchase Purchase @relation(fields:[purchaseId],references:[id],onDelete:Restrict)
 product Product @relation(fields:[productId],references:[id],onDelete:Restrict) 
}

model InventoryMovement {
 id String @id @default(uuid())
 productId String
 quantity Decimal @db.Decimal(14,3)
 type String
 referenceId String?
 note String?
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 product Product @relation(fields:[productId],references:[id],onDelete:Restrict)
 @@index([productId,createdAt]) 
}

model CustomerPayment {
 id String @id @default(uuid())
 customerId String
 amountMinor BigInt
 method PaymentMethod
 note String?
 customer Customer @relation(fields:[customerId],references:[id],onDelete:Restrict)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model SupplierPayment {
 id String @id @default(uuid())
 supplierId String
 amountMinor BigInt
 method PaymentMethod
 note String?
 supplier Supplier @relation(fields:[supplierId],references:[id],onDelete:Restrict)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model Expense {
 id String @id @default(uuid())
 title String
 amountMinor BigInt
 category String?
 note String?
 createdById String
 createdBy StaffUser @relation(fields:[createdById],references:[id],onDelete:Restrict)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model CashSession {
 id String @id @default(uuid())
 openingMinor BigInt
 terminalId String?
 terminal Terminal? @relation(fields:[terminalId],references:[id],onDelete:SetNull)
 closingMinor BigInt?
 status CashStatus @default(OPEN)
 openedById String
 openedBy StaffUser @relation(fields:[openedById],references:[id])
 openedAt DateTime @default(now()) @db.Timestamptz(3)
 closedAt DateTime? @db.Timestamptz(3)
 @@index([openedById,status]) 
}

model Approval {
 id String @id @default(uuid())
 action String
 reason String
 grantorId String
 usedById String?
 expiresAt DateTime @db.Timestamptz(3)
 usedAt DateTime? @db.Timestamptz(3)
 terminalId String?
 cashierSessionId String?
 targetId String?
 amountMinor BigInt?
 grantor StaffUser @relation("ApprovalGrantor",fields:[grantorId],references:[id])
 usedBy StaffUser? @relation("ApprovalUser",fields:[usedById],references:[id])
 terminal Terminal? @relation(fields:[terminalId],references:[id],onDelete:SetNull)
 refund Refund? 
}

model IdempotencyKey {
 id String @id @default(uuid())
 key String
 scope String
 actorId String
 status IdempotencyStatus
 response Json?
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@unique([key,scope,actorId]) 
}

model AuditLog {
 id String @id @default(uuid())
 actorId String?
 action String
 entity String
 entityId String?
 surface Surface?
 success Boolean @default(true)
 outcome String @default("success")
 actorType String?
 actorRoleSnapshot String?
 ip String?
 userAgent String?
 requestId String?
 sessionRef String?
 terminalId String?
 changes Json?
 metadata Json?
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 actor StaffUser? @relation(fields:[actorId],references:[id],onDelete:SetNull)
 @@index([createdAt])
 @@index([actorId,createdAt]) 
}

model Setting {
 id String @id @default(uuid())
 key String @unique
 value Json
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model ContactMessage {
 id String @id @default(uuid())
 name String
 email String
 message String
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 handledAt DateTime? @db.Timestamptz(3)
}

model WebSocketTicket {
 id String @id @default(uuid())
 tokenHash String @unique
 kind Surface
 actorId String
 expiresAt DateTime @db.Timestamptz(3)
 usedAt DateTime? @db.Timestamptz(3)
}

